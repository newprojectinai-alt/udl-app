PORT=5000
FRONTEND_URL=http://localhost:5173
# Comma-separated exact origins. In production, add your Vercel production URL.
FRONTEND_URLS=http://localhost:5173
# Optional for Vercel preview deployments. Prefer exact FRONTEND_URLS in production.
CORS_ORIGIN_REGEX=

# AI Provider
# Use "gemini" for Google AI Studio free-tier testing.
# Use "openai" if you later want OpenAI.
AI_PROVIDER=gemini

# Gemini / Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI optional fallback
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL=gpt-4o-mini

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=textbooks

# Optional: OpenRouter free-model provider
# To use this, set AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-3-27b-it:free
APP_URL=http://localhost:5173

# Text-to-video provider
# Preferred: run CogVideoX-5B on your own GPU server and put its API URL here.
VIDEO_API_ENDPOINT=
VIDEO_API_TOKEN=
# Use "async" with the RunPod /jobs endpoint to avoid the HTTP proxy timeout.
VIDEO_API_MODE=async
VIDEO_API_POLL_SECONDS=5
VIDEO_API_REQUEST_TIMEOUT_SECONDS=90

# Optional Hugging Face fallback
# Create a token at https://huggingface.co/settings/tokens and paste it here.
HF_TOKEN=your_hugging_face_token_here
HF_VIDEO_MODEL=zai-org/CogVideoX-5b
# Optional: use this instead of HF_VIDEO_MODEL if you create a dedicated HF Inference Endpoint.
HF_VIDEO_ENDPOINT=
HF_VIDEO_TIMEOUT_SECONDS=900
HF_VIDEO_NUM_FRAMES=49
HF_VIDEO_NUM_STEPS=30
HF_VIDEO_GUIDANCE_SCALE=6.0
HF_VIDEO_MIN_BYTES=100000
HF_VIDEO_RENDER_SCENES=true
HF_VIDEO_MAX_SCENES=6

# AWS S3 media storage. Required for ECS/Fargate because container files are temporary.
AWS_REGION=eu-central-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=udl-learn
AWS_S3_PRESIGNED_TTL_SECONDS=3600

# Optional local Kokoro TTS settings
PYTHON_COMMAND=python
KOKORO_VOICE=af_heart
VIDEO_FPS=20
SKIP_TTS=false
